# Telegram bot token from @BotFather
BOT_TOKEN=replace_with_telegram_bot_token

# Comma-separated numeric IDs, @usernames, or both
ADMIN_TELEGRAM_IDS=7513839793,@your_username

# Local testing: SQLite. For production, use a PostgreSQL async URL.
DATABASE_URL=sqlite+aiosqlite:///./fleet_faults.db
# DATABASE_URL=postgresql+asyncpg://username:password@localhost/samsara_bot

# Used to encrypt Samsara API tokens before database storage.
# Generate a Fernet-compatible key as documented in README; never commit it.
TOKEN_ENCRYPTION_KEY=replace_with_secure_random_key

TIMEZONE=America/New_York
LOG_LEVEL=INFO
# Leave empty on Railway; logs are written to stdout.
LOG_FILE=

# Lets Samsara finish attaching both camera views before Telegram delivery.
SAFETY_NOTIFICATION_DELAY_SECONDS=90
